# =========================
# 2. 轉換變項為文字
# =========================
data_plot <- data_new %>%
mutate(
vq29_text = recode(as.character(vq29), !!!vq29_labels),
vq24_text = recode(as.character(vq24), !!!vq24_labels),
# 合併總花費範圍
cost_group = case_when(
vq29 %in% 1:4 ~ "2萬2千5百元以下",
vq29 %in% 5:8 ~ "2萬2千5百元～未滿4萬2千5百元",
vq29 %in% 9:12 ~ "4萬2千5百元～未滿7萬5千元",
vq29 %in% 13:17 ~ "7萬5千元～未滿12萬5千元",
vq29 %in% 18:22 ~ "12萬5千元以上",
vq29 == 88 ~ "不知道",
vq29 == 99 ~ "拒答",
TRUE ~ NA_character_
),
# 給小提琴圖使用的花費中位數
cost_mid = case_when(
vq29 == 1 ~ 3750,
vq29 == 2 ~ 10000,
vq29 == 3 ~ 15000,
vq29 == 4 ~ 20000,
vq29 == 5 ~ 25000,
vq29 == 6 ~ 30000,
vq29 == 7 ~ 35000,
vq29 == 8 ~ 40000,
vq29 == 9 ~ 45000,
vq29 == 10 ~ 51250,
vq29 == 11 ~ 60000,
vq29 == 12 ~ 70000,
vq29 == 13 ~ 80000,
vq29 == 14 ~ 90000,
vq29 == 15 ~ 100000,
vq29 == 16 ~ 110000,
vq29 == 17 ~ 120000,
vq29 == 18 ~ 130000,
vq29 == 19 ~ 140000,
vq29 == 20 ~ 150000,
vq29 == 21 ~ 160000,
vq29 == 22 ~ 170000,
TRUE ~ NA_real_
)
)
# =========================
# 圖一：vq29 出國總花費 / vq24 旅遊目的
# 小提琴圖
# =========================
ggplot(
data_plot %>%
filter(!is.na(cost_mid), !is.na(vq24_text)),
aes(
x = vq24_text,
y = cost_mid
)
) +
geom_violin(trim = FALSE) +
geom_boxplot(width = 0.12, outlier.shape = NA) +
scale_y_continuous(labels = comma) +
labs(
title = "不同旅遊目的的出國總花費分布",
x = "旅遊目的",
y = "出國總花費：約略金額"
) +
theme_minimal()
# =========================
# 圖一：vq29 出國總花費 / vq24 旅遊目的
# 堆疊長條圖
# =========================
cost_purpose <- data_plot %>%
filter(
!is.na(cost_group),
!is.na(vq24_text),
!cost_group %in% c("不知道", "拒答")
) %>%
count(vq24_text, cost_group) %>%
group_by(vq24_text) %>%
mutate(percent = n / sum(n)) %>%
ungroup()
ggplot(
cost_purpose,
aes(
x = vq24_text,
y = percent,
fill = cost_group
)
) +
geom_col() +
scale_y_continuous(labels = percent_format()) +
labs(
title = "不同旅遊目的的出國總花費區間比例",
x = "旅遊目的",
y = "比例",
fill = "總花費區間"
) +
theme_minimal()
# =========================
# 圖二：vq24 旅遊目的 / vq23 旅遊國家
# 圓餅圖
# =========================
country_long <- data_new %>%
pivot_longer(
cols = vq23_1:vq23_10,
names_to = "country_order",
values_to = "vq23"
) %>%
filter(!is.na(vq23)) %>%
mutate(
vq24_text = recode(as.character(vq24), !!!vq24_labels),
vq23_text = recode(as.character(vq23), !!!vq23_labels)
) %>%
filter(!is.na(vq24_text), !is.na(vq23_text))
# 例：只看「休閒、遊憩、度假」者去了哪些國家
pie_data <- country_long %>%
filter(vq24_text == "休閒、遊憩、度假") %>%
count(vq23_text) %>%
mutate(
percent = n / sum(n),
vq23_text = fct_reorder(vq23_text, n)
)
ggplot(
pie_data,
aes(
x = "",
y = n,
fill = vq23_text
)
) +
geom_col(width = 1) +
coord_polar(theta = "y") +
labs(
title = "休閒、遊憩、度假旅客的旅遊國家分布",
fill = "旅遊國家"
) +
theme_void()
